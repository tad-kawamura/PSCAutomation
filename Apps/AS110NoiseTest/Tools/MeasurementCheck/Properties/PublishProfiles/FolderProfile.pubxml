<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <PublishProtocol>FileSystem</PublishProtocol>
    <!-- 発行.cmd・docs/測定シーケンス実機確認.md の案内と同じ場所 -->
    <PublishDir>bin\publish\</PublishDir>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <!-- デバッグ情報(.pdb)も exe に入れ、発行フォルダーに exe 以外を出さない(雛形フォルダーと 実機確認.cmd を除く) -->
    <DebugType>embedded</DebugType>
    <!-- 参照している Wrappers・アプリの .pdb も発行フォルダーへコピーしない -->
    <AllowedReferenceRelatedFileExtensions>.none</AllowedReferenceRelatedFileExtensions>
    <!-- アプリ本体(AS110NoiseTest.exe、自己完結にしていない)をライブラリとして参照しているため、自己完結どうしかの検査を外す。
         アプリ本体のコードは MeasurementCheck.exe の中に入る(旧 発行.cmd はコマンドラインの指定で全プロジェクトを自己完結にしていた) -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
  </PropertyGroup>
</Project>
