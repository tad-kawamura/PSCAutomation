<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- exe 名は元のまま(AS110NoiseTest.exe) -->
    <AssemblyName>AS110NoiseTest</AssemblyName>
    <RootNamespace>PSCAutomation.Apps.AS110NoiseTest</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- 確認ツールと資料はこのフォルダーの下にあるが、アプリには含めない -->
    <Compile Remove="Tools\**;docs\**" />
    <EmbeddedResource Remove="Tools\**;docs\**" />
    <None Remove="Tools\**;docs\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- 実機確認ツールから電流制御クラスを直接使う。 -->
    <InternalsVisibleTo Include="CurrentControlCheck" />
    <!-- 判定規則の検証ツールから判定クラスを直接使う。 -->
    <InternalsVisibleTo Include="NoiseJudgeCheck" />
    <!-- Excel 出力の確認ツールから書き込みクラスを直接使う。 -->
    <InternalsVisibleTo Include="ExcelWriteCheck" />
    <!-- 測定シーケンスの確認ツール(機器なし / LOGGER だけ実機 / 全部実機)からシーケンスを直接使う。 -->
    <InternalsVisibleTo Include="MeasurementCheck" />
  </ItemGroup>

  <ItemGroup>
    <!-- KEYENCE WAVE LOGGER(NR-500)の操作 -->
    <ProjectReference Include="..\..\Wrappers\WaveLogger.Automation\WaveLogger.Automation.csproj" />
    <!-- xdt の読み出し・表示レンジ・測定日時 -->
    <ProjectReference Include="..\..\Wrappers\LoggerFiles\LoggerFiles.csproj" />
    <!-- WF1973(DC オフセット)・ADCMT 7351E(NI-VISA が要る) -->
    <ProjectReference Include="..\..\Wrappers\Instruments\Instruments.csproj" />
    <!-- 結果ブックへの書き込み(Excel を起動して操作) -->
    <ProjectReference Include="..\..\Wrappers\Excel\Excel.csproj" />
    <!-- 最前面のメッセージ(ErrorNotification)、結果 Excel・画面を前に出す(WindowActivation) -->
    <ProjectReference Include="..\..\Wrappers\Common\Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 雛形(測定用 xdt・結果 Excel・型式一覧)を exe の隣の 雛形\ にコピーする。単一ファイルで発行しても exe に入れない
         (雛形や型式一覧を差し替えるたびに発行し直さずに済むように。AGENTS.md)。開発中はアプリのフォルダーの 雛形 も見つかる。 -->
    <None Update="雛形\AS110ノイズ測定用.xdt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Update="雛形\AS110ノイズ測定_雛形.xlsx" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Update="雛形\型式一覧.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>
</Project>
