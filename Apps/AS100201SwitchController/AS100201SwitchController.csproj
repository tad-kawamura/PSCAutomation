<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- exe 名は元のまま(AS100201SwitchController.exe)。異常ログの代わりの保存先のフォルダー名も同じ -->
    <AssemblyName>AS100201SwitchController</AssemblyName>
    <RootNamespace>PSCAutomation.Apps.AS100201SwitchController</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- 互換テスト・Arduino スケッチはこのフォルダーの下にあるが、アプリには含めない -->
    <Compile Remove="Tests\**;firmware\**;雛形\**" />
    <EmbeddedResource Remove="Tests\**;firmware\**;雛形\**" />
    <None Remove="Tests\**;firmware\**;雛形\**" />
    <!-- 学習モードの雛形(2026-11-10)。exe に入れず、exe の隣の「雛形」フォルダーへ出す(人が差し替えるため) -->
    <Content Include="雛形\**\*">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- 互換テストから設定値とプロトコルクラスを直接使う(元: Properties/AssemblyInfo.cs) -->
    <InternalsVisibleTo Include="AS100201.RegressionTests" />
  </ItemGroup>

  <ItemGroup>
    <!-- KEYENCE WAVE LOGGER(NR-500 / NR-X、USB) -->
    <ProjectReference Include="..\..\Wrappers\WaveLogger.Automation\WaveLogger.Automation.csproj" />
    <!-- NR-500 / NR-X の本体確認(NrDeviceConnections)、エラー表示、PC 遅延観測 -->
    <ProjectReference Include="..\..\Wrappers\Common\Common.csproj" />
    <!-- スイッチ・READY LED の Arduino(USB シリアル)と異常ログ -->
    <ProjectReference Include="..\..\Wrappers\Arduino\Arduino.csproj" />
    <!-- WF1973 の連続出力(NI-VISA が要る) -->
    <ProjectReference Include="..\..\Wrappers\Instruments\Instruments.csproj" />
    <!-- 学習モードの測定中の取り込み(2026-11-11): 雛形の xdt からチャンネル・換算係数を読む -->
    <ProjectReference Include="..\..\Wrappers\LoggerFiles\LoggerFiles.csproj" />
  </ItemGroup>
</Project>
