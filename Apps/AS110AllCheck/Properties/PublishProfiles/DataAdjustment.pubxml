<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!-- 発行のたびに版を上げる。「データ調整verX.YY」をPublishDir・AssemblyName・AssemblyTitle・Productにそろえ、Version＝X.0.YY（例 ver1.03＝1.0.3）とする。 -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>bin\データ調整ver3.01\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
    <TargetFramework>net9.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <PublishReadyToRun>false</PublishReadyToRun>
    <!-- 参照している Wrappers の .pdb も発行フォルダーへコピーしない(PSCAutomation の発行のきまり) -->
    <AllowedReferenceRelatedFileExtensions>.none</AllowedReferenceRelatedFileExtensions>
    <AssemblyName>データ調整ver3.01</AssemblyName>
    <AssemblyTitle>データ調整ver3.01</AssemblyTitle>
    <Product>データ調整ver3.01</Product>
    <Version>3.0.1</Version>
    <FileVersion>3.0.1.0</FileVersion>
  </PropertyGroup>
  <Target Name="ExcludePrototypeDebugSymbols" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>
</Project>
