<Project Sdk="Microsoft.NET.Sdk">
  <!-- 実機を使わない工程・校正・変換・漏れ判定の検査。機器・Excel なしで dotnet run できる(LOGGER の部品の型を使うので net9.0-windows) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <!-- アプリのうち Windows に依存しない部分だけを直接取り込む -->
    <Compile Include="../../As110/As110Calibration.cs" Link="App/As110Calibration.cs" />
    <Compile Include="../../As110/CalibrationRecord.cs" Link="App/CalibrationRecord.cs" />
    <Compile Include="../../As110/As110MotionTest.cs" Link="App/As110MotionTest.cs" />
    <Compile Include="../../Production/ProductionWorkflow.cs" Link="App/ProductionWorkflow.cs" />
    <Compile Include="../../Production/LeakCheckSequence.cs" Link="App/LeakCheckSequence.cs" />
    <Compile Include="../../Production/LeakJudge.cs" Link="App/LeakJudge.cs" />
    <Compile Include="../../Production/LeakTestRecordFile.cs" Link="App/LeakTestRecordFile.cs" />
    <Compile Include="../../Production/SaveFolder.cs" Link="App/SaveFolder.cs" />
    <Compile Include="../../Production/FileAccessAdvice.cs" Link="App/FileAccessAdvice.cs" />
    <Compile Include="../../Production/MeasurementProfile.cs" Link="App/MeasurementProfile.cs" />
    <Compile Include="../../Production/SupplyPressure.cs" Link="App/SupplyPressure.cs" />
    <Compile Include="../../Calibration/AutoCalibration.cs" Link="App/AutoCalibration.cs" />
    <Compile Include="../../Calibration/CalibrationInProgressMarker.cs" Link="App/CalibrationInProgressMarker.cs" />
    <Compile Include="../../Excel/TransferSettings.cs" Link="App/TransferSettings.cs" />
    <!-- 発振器の設定値の型だけを使う(Instruments は NI-VISA を要るので参照しない) -->
    <Compile Include="../../../../Wrappers/Instruments/Generators/GeneratorBurstSettings.cs" Link="Wrappers/GeneratorBurstSettings.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- xdt の読み取り・校正の書き換え・NR-X の CSV、雛形への書き込み(どちらも net9.0、機器・Excel 不要) -->
    <ProjectReference Include="../../../../Wrappers/LoggerFiles/LoggerFiles.csproj" />
    <ProjectReference Include="../../../../Wrappers/Excel/Excel.csproj" />
    <!-- 漏れ判定の取り出し結果の型(LoggerRawDataBlock)と無効値のしきい値だけを使う(COM は呼ばない) -->
    <ProjectReference Include="../../../../Wrappers/WaveLogger.Automation/WaveLogger.Automation.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../../雛形/*.xdt" Link="Fixtures/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
