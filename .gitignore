# Visual Studio / .NET
bin/
obj/
.vs/
*.user
*.suo
packages/
TestResults/
publish/
# 人が使う発行物の置き場(exe と雛形の写し。リポジトリには入れない)
/発行/

# 計測データ・ログ・マニュアル類はリポジトリに入れない
*.xdt
*.ydt
*.pdf
*.xlsx
*.log
Logs/
学習データ/
試験データ/
# 雛形(測定用 xdt と結果 Excel)と docs 内の資料は入れる
!雛形/*.xdt
!雛形/*.xlsx
!**/雛形/*.xdt
!**/雛形/*.xlsx
!docs/**/*.xlsx
!**/Verification/Fixtures/*.xdt
# wrapper のテスト用の照合データ(Wrappers/Tests/<テスト>/Fixtures)は入れる
!Wrappers/Tests/**/Fixtures/*.xdt
!Wrappers/Tests/**/Fixtures/*.ydt
~$*

# 試験データから作った波形画像(AS110NoiseTest)
**/docs/実測比較_*_波形.png

# Python の一時ファイル
__pycache__/

# Arduino の生成物(.ino を正本とする)
*.ino.cpp
